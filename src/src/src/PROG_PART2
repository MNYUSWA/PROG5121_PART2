package com.mycompany.prog5121_part2;

import java.util.ArrayList;
import java.util.Scanner;

public class PROG5121_PART2 {
    public static void main(String[] args) {
        try (Scanner scanner = new Scanner(System.in)) {
            Login authApp = new Login();
            
            System.out.println("=== USER REGISTRATION ===");
            System.out.print("Enter First Name: ");
            String firstName = scanner.nextLine();
            System.out.print("Enter Last Name: ");
            String lastName = scanner.nextLine();
            System.out.print("Enter Username: ");
            String username = scanner.nextLine();
            System.out.print("Enter Password: ");
            String password = scanner.nextLine();
            System.out.print("Enter Cell Phone Number (+27...): ");
            String cellNumber = scanner.nextLine();
            
            String regStatus = authApp.registerUser(firstName, lastName, username, password, cellNumber);
            System.out.println("\n" + regStatus);
            
            if (!regStatus.equals("Username successfully captured.")) {
                System.out.println("Registration failed. Exiting.");
                scanner.close();
                return;
            }
            
            // Login section
            System.out.println("\n=== USER LOGIN ===");
            System.out.print("Enter Username: ");
            String inputUser = scanner.nextLine();
            System.out.print("Enter Password: ");
            String inputPass = scanner.nextLine();
            
            boolean loginSuccess = authApp.loginUser(inputUser, inputPass);
            System.out.println("\n" + authApp.returnLoginStatus(loginSuccess));
            
            // Requirement 1: Users should only be able to send messages if they have logged in successfully
            if (!loginSuccess) {
                scanner.close();
                return;
            }
            
            // Requirement 2: Display welcome message "Welcome to QuickChat.
            System.out.println("\nWelcome to QuickChat.");
            
            ArrayList<Message> sentMessagesList = new ArrayList<>();
            boolean running = true;
            
            // Requirement 4: The application should run until the user selects 'quit' to exit
            while (running) {
                System.out.println("\n--- QUICKCHAT MENU ---");
                System.out.println("1) Send Messages");
                System.out.println("2) Show recently sent messages");
                System.out.println("3) Quit");
                System.out.print("Choose an option (1-3): ");
                
                String choiceStr = scanner.nextLine();
                int choice;
                try {
                    choice = Integer.parseInt(choiceStr);
                } catch (NumberFormatException e) {
                    System.out.println("Invalid input. Please enter 1, 2, or 3.");
                    continue;
                }
                
                switch (choice) {
                    case 1 -> {
                        // Requirement 5: Users define how many messages they wish to enter
                        System.out.print("How many messages would you like to send? ");
                        int totalMessages;
                        try {
                            totalMessages = Integer.parseInt(scanner.nextLine());
                        } catch (NumberFormatException e) {
                            System.out.println("Invalid number. Returning to menu.");
                            break;
                        }
                        
                        for (int i = 1; i <= totalMessages; i++) {
                            System.out.println("\n--- Message " + i + " of " + totalMessages + " ---");
                            
                            System.out.print("Enter recipient cell phone number: ");
                            String recipient = scanner.nextLine();
                            
                            System.out.print("Enter your message (max 250 characters): ");
                            String text = scanner.nextLine();
                            
                            Message msg = new Message(recipient, text, i);
                            
                            // Validate message length and recipient
                            System.out.println(msg.checkMessageLengthStatus());
                            if (!msg.checkMessageLength()) {
                                i--; // Retry this message slot
                                continue;
                            }
                            
                            System.out.println(msg.getRecipientCellStatus());
                            
                            // Send message action options (1: Send, 2: Disregard, 3: Store)
                            System.out.println("\nChoose action:");
                            System.out.println("1) Send Message");
                            System.out.println("2) Disregard Message");
                            System.out.println("3) Store Message to send later");
                            System.out.print("Enter choice (1-3): ");
                            
                            int actionChoice = 1;
                            try {
                                actionChoice = Integer.parseInt(scanner.nextLine());
                            } catch (NumberFormatException ignored) {}
                            
                            String actionResult = msg.sendMessage(actionChoice);
                            System.out.println(actionResult);
                            
                            // Requirement 7: Full details displayed in order: Message ID, Message Hash, Recipient, Message
                            System.out.println("\n--- Message Summary ---");
                            System.out.println(msg.printMessages());
                            
                            sentMessagesList.add(msg);
                        }
                        
                        // Requirement 6: Total number of messages accumulated and displayed
                        System.out.println("\nTotal messages processed/sent in session: " + sentMessagesList.size());
                    }
                        
                    case 2 -> System.out.println("\nComing Soon.");
                        
                    case 3 -> {
                        System.out.println("\nExiting QuickChat. Goodbye!");
                        running = false;
                    }
                        
                    default -> System.out.println("Invalid option. Please choose 1, 2, or 3.");
                }
            }
        }
    }
}
